# Docker environment variables template
# Copy to .env.docker and update values with secure passwords

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_VERSION=16

# Symfony application environment
APP_ENV=dev
APP_SECRET=YOUR_SECRET_KEY_HERE

# Database configuration for Docker
DATABASE_URL="postgresql://app:YOUR_SECURE_PASSWORD_HERE@database:5432/app?serverVersion=16&charset=utf8"

# JWT configuration
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=YOUR_JWT_PASSPHRASE_HERE

# Fixture passwords (for development only)
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE
USER_PASSWORD=YOUR_USER_PASSWORD_HERE
TEST_PASSWORD=YOUR_TEST_PASSWORD_HERE
AUTHOR_PASSWORD=YOUR_AUTHOR_PASSWORD_HERE
